        </Level>
        <Level name="Volume" visible="true" table="dim_product" column="measure" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
        <Level name="Medida" visible="true" table="dim_product" column="measure_type" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="Unidade de Medida">
        </Level>
        <Level name="Vlr.Revenda" visible="true" table="dim_product" column="value" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="valor de revenda">
        </Level>
        <Level name="Vlr.Insumo" visible="true" table="dim_product" column="use_value" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="valor de insumo">
        </Level>
        <Level name="Ativo" visible="true" table="dim_product" column="active" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
        <Level name="Vlr.Tabela" visible="true" table="dim_product" column="default_value" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="valor de tabela">
        </Level>
        <Level name="Margem Revenda" visible="true" table="dim_product" column="profit" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="margem de revenda">
        </Level>
        <Level name="Margem Insumo" visible="true" table="dim_product" column="use_profit" type="Numeric" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
        <Level name="Cod.NCM" visible="true" table="dim_product" column="ncm_code" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="c&#243;digo NCM">
        </Level>
        <Level name="Cod.Barras" visible="true" table="dim_product" column="bar_code" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="c&#243;digo de barras">
        </Level>
        <Level name="Cod.Interno" visible="true" table="dim_product" column="cod" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="c&#243;digo interno">
        </Level>
        <Level name="Peso.Embalagem" visible="true" table="dim_product" column="weight" type="Integer" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
        <Level name="Qtde.Estoque" visible="true" table="dim_product" column="stock_quantity" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="quantidade do item em estoque">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="fk_professional" highCardinality="false" name="profissional">
      <Hierarchy name="profissional" visible="true" hasAll="true" primaryKey="fk_professional">
        <Table name="dim_professional" schema="public">
        </Table>
        <Level name="Profissionais" visible="true" table="dim_professional" column="nome" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
        <Level name="Equipe" visible="true" column="equipe" type="String" uniqueMembers="true" levelType="Regular" hideMemberIf="Never">
        </Level>
      </Hierarchy>
      <Hierarchy name="equipe" visible="true" hasAll="true" primaryKey="fk_professional">
        <Table name="dim_professional" schema="public">
        </Table>
        <Level name="Equipe" visible="true" column="equipe" type="String" uniqueMembers="true" levelType="Regular" hideMemberIf="Never">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="id_fact_stock" highCardinality="false" name="estoque">
      <Hierarchy name="estoque" visible="true" hasAll="true" allMemberCaption="Todos os Estoques" allLevelName="Estoque Geral" primaryKey="id_fact_stock">
        <Table name="fact_stock" schema="public">
        </Table>
        <Level name="Estoque" visible="true" column="name" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" caption="Nome do Estoque">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="id_fact_stock" highCardinality="false" name="movimento">
      <Hierarchy name="movimento" visible="true" hasAll="true" primaryKey="id_fact_stock">
        <Table name="fact_stock" schema="public">
        </Table>
        <Level name="Movimentos" visible="true" column="type" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="fk_tag" highCardinality="false" name="marca">
      <Hierarchy name="marca" visible="true" hasAll="true" primaryKey="fk_tag">
        <Table name="brand" schema="public">
        </Table>
        <Level name="Marca" visible="true" table="brand" column="name" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="id_fact_stock" highCardinality="false" name="linha">
      <Hierarchy name="linha" visible="true" hasAll="true" primaryKey="id_fact_stock">
        <Table name="fact_stock" schema="public">
        </Table>
        <Level name="Linha" visible="true" column="line" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="id_fact_stock" highCardinality="false" name="vencimento">
      <Hierarchy name="vencimento" visible="true" hasAll="true" primaryKey="id_fact_stock">
        <Table name="fact_stock" schema="public">
        </Table>
        <Level name="Dia Vencimento" visible="true" column="expiration" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" description="Data Vencimento do Produto">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="TimeDimension" visible="true" foreignKey="fk_expire" highCardinality="false" name="validade">
      <Hierarchy name="validade" visible="true" hasAll="true" allMemberName="Todos Per&#237;odos" primaryKey="fk_time" description="Data em que expira a validade dos produtos">
        <Table name="dim_time" schema="public">
        </Table>
        <Level name="Ano Validade" visible="true" table="dim_time" column="ano" type="Numeric" uniqueMembers="true" levelType="TimeYears" hideMemberIf="Never" description="filtrar produtos que vencem em um determinado ano">
        </Level>
        <Level name="Mes Validade" visible="true" table="dim_time" column="anoespmes" type="String" uniqueMembers="false" levelType="TimeMonths" hideMemberIf="Never" description="filtrar produtos que vencem em um determinado m&#234;s">
        </Level>
      </Hierarchy>
    </Dimension>
    <Dimension type="StandardDimension" visible="true" foreignKey="fk_comp" highCardinality="false" name="company">
      <Hierarchy name="company" visible="true" hasAll="true" primaryKey="fk_comp" caption="sal&#227;o">
        <Table name="dim_company" schema="public">
        </Table>
        <Level name="Salon" visible="true" table="dim_company" column="name" type="String" uniqueMembers="false" levelType="Regular" hideMemberIf="Never" caption="Sal&#227;o">
        </Level>
      </Hierarchy>
    </Dimension>
    <Measure name="Consumo" column="quantity_un" datatype="Numeric" formatString="0.0" aggregator="sum" description="Consumo do produto bruto sem formata&#231;&#227;o de Volume e Medida" visible="true">
    </Measure>
    <Measure name="measure" column="service_type_measure" datatype="Numeric" aggregator="avg" visible="false">
    </Measure>
    <CalculatedMember name="ItemsVsMeasure" formula="[Measures].[Consumo]*[Measures].[measure]" dimension="Measures" visible="false">
    </CalculatedMember>
    <CalculatedMember name="DivideBy" formula="[Measures].[ItemsVsMeasure]/[Measures].[measure]" dimension="Measures" visible="false">
    </CalculatedMember>
    <CalculatedMember name="LessClose" formula="IIf(([Measures].[Unidade] = 0), 0, [Measures].[DivideBy]-[Measures].[Unidade])" dimension="Measures" visible="false">
    </CalculatedMember>
    <CalculatedMember name="Unidade" description="Consumo Fechado (unidades completas)" formula="Fix([Measures].[Consumo])" dimension="Measures" visible="true">
    </CalculatedMember>
    <CalculatedMember name="Fracao" formatString="0" description="consumo de frasco francionado de acordo com o volume e medida configurado no sistema" formula="[Measures].[LessClose]*[Measures].[measure]" dimension="Measures" visible="true">
    </CalculatedMember>
  </Cube>
</Schema>
