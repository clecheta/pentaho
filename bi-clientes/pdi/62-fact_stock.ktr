    <connection>wbsl</connection>
    <sql>--CREATE INDEX idx_service_type_tag ON service_type_tag&#x28;service_type_id, tag_id&#x29;&#x3b; &#xa;&#xa;SELECT s.company_id,&#xa;       s.name,&#xa;       s.type stock_type,&#xa;       p.create_date product_register_date,&#xa;       p.expiration,&#xa;       p.service_type_id,&#xa;       --sph.measure, --fracao que foi vendida&#xa;       --&#x28;sph.measure &#x2a; sph.quantity&#x29; quantity_vol, --mostra em gr&#x2f;ml e nao em unidade&#xa;       abs&#x28;sph.items&#x29; as quantity_un,&#xa;       --the below fields are calculated in the OLAP cube with MDX so that the agregations work properly.&#xa;       --trunc&#x28;&#x28;sph.items&#x2a;-1&#x29;&#x29; as quantity_close,&#xa;       --abs&#x28;mod&#x28;CAST&#x28;&#x28;sph.items&#x2a;sph.measure&#x29; AS NUMERIC&#x29;,st.measure&#x29;&#x29; as qtde_open,&#xa;       sph.professional_id,&#xa;       sph.type,&#xa;       sph.create_date movement_date,&#xa;       COALESCE&#x28;&#x28;SELECT s1.name from stock s1 where s1.id&#x3d;sph.origin_id&#x29;, &#x27;SEM ESTOQUE&#x27;&#x29; as stock_origin,&#xa;       st.measure service_type_measure,&#xa;       t.id tag_id, --brand&#xa;--       t.id tag_id, --mapear novamente para tipo de uso&#xa;       &#x28;SELECT foo.line_list FROM &#x28;&#xa;           SELECT tg.type, string_agg&#x28;name, &#x27;, &#x27;&#x29; AS line_list FROM tag tg &#xa;            WHERE tg.id IN &#x28;SELECT stt.tag_id FROM service_type_tag stt WHERE stt.service_type_id &#x3d; st.id &#x29; &#xa;              AND tg.type &#x3d; &#x27;LINE&#x27;&#xa;            GROUP BY 1&#xa;       &#x29; AS foo&#x29; AS line,&#xa;       p.expiration expiration_date,&#xa;       ai.appointment_id&#xa;  FROM stock_product_history sph -- fazer o controrario, ler primeiro stock_procut para ver tamb&#xe9;m o que nao foi movimentando&#xa; INNER JOIN stock_product p ON p.id &#x3d; sph.stock_product_id&#xa; INNER JOIN stock s ON s.id &#x3d; p.stock_id&#xa;  LEFT JOIN service_type st ON p.service_type_id &#x3d; st.id&#xa;  LEFT JOIN service_type_tag stt ON stt.service_type_id &#x3d; st.id&#xa;  LEFT JOIN tag t ON stt.tag_id &#x3d; t.id&#xa;  LEFT JOIN appointment_item ai ON ai.stock_product_history_id &#x3d; sph.id&#xa; WHERE s.company_id IN &#x28;&#x24;&#x7b;COMPANY_ID&#x7d;&#x29;&#xa;   AND sph.create_date &#x3e;&#x3d; &#x27;&#x24;&#x7b;BEGIN_DATE&#x7d;&#x27;&#xa;   AND sph.create_date &#x3c;&#x3d; &#x27;&#x24;&#x7b;END_DATE&#x7d;&#x27;&#xa;   AND sph.type NOT IN &#x28;&#x27;APPOINTMENT_ITEM_REMOVE&#x27;,&#x27;INVENTORY_COUNT&#x27;&#x29;&#xa;   -- para nao considerar as remocoes de antedimento&#xa;   AND &#x28;sph.type IN &#x28;&#x27;APPOINTMENT_USE&#x27;,&#x27;APPOINTMENT_SALE&#x27;,&#x27;REPLACEMENT&#x27;,&#x27;TRANSFER&#x27;,&#x27;INVENTORY&#x27;,&#x27;INCOMING&#x27;,&#x27;OUTCOMING&#x27;&#x29; OR ai.appointment_id is not null&#x29;&#xa;   AND t.type&#x3d;&#x27;BRAND&#x27;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
