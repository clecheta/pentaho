  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>wbsl</connection>
    <sql>SELECT date&#x28;t.create_date&#x29; AS production_date,&#xa;       &#x28;SELECT ap2.id from appointment ap2 where ap2.id&#x3d;ap.id and ap2.by_preference is true&#x29; as preference,&#xa;       CASE WHEN a.type&#x3d;&#x27;PROF&#x27; THEN Abs&#x28;t.value&#x29; ELSE 0 END as value_prof,&#xa;       CASE WHEN &#x28;a.type&#x3d;&#x27;COMP&#x27;&#x29; THEN Abs&#x28;t.value&#x29; ElSE 0 END as value_comp,&#xa;       CASE WHEN &#x28;a.type&#x3d;&#x27;COMP&#x27;&#x29; THEN at.tax ELSE 0 END as tax,&#xa;       CASE WHEN &#x28;a.type&#x3d;&#x27;COMP&#x27;&#x29; THEN at.tax_value ELSE 0 END as tax_value,&#xa;       CASE WHEN &#x28;a.type&#x3d;&#x27;COMP&#x27;&#x29; THEN at.not_embedded_value ELSE 0 END as use_service,&#xa;       CASE WHEN &#x28;a.type&#x3d;&#x27;COMP&#x27;&#x29; THEN at.embedded_value ELSE 0 END as fix_service,&#xa;       CASE WHEN ai.appointment_item_link_id is not null THEN Abs&#x28;t.value&#x29; ELSE 0 END as value_use,&#xa;       CASE WHEN &#x28;ai.appointment_item_link_id is null and st.product&#x3d;true&#x29; THEN Abs&#x28;t.value&#x29; ELSE 0 END as value_sell,&#xa;       CASE WHEN ai.appointment_item_link_id is null THEN t.value ELSE 0 END as value,&#xa;       ap.customer_id,&#xa;       ap.id as appointment_id,&#xa;       --serve para identificar o profissional quando a producao for do salao, senao precisaria apenas p.id&#xa;       COALESCE&#x28;p.id, ap.professional_id&#x29; as professional_id,&#xa;       at.professional_supervisor_id as supervisor_id,&#xa;       at.professional_supervisor_id is not null as is_pass_value,&#xa;       ap.professional_supervisor_id as professional_supervisor_id, &#xa;       st.id as service_type_id,&#xa;       tg.id as skill_id,&#xa;       tg.id as brand_id,&#xa;       at.voucher_id,&#xa;       at.discount as before_discount,&#xa;       at.promo_id,&#xa;       at.before_promotion,&#xa;       &#x28;ai.quantity&#x2a;ai.measure&#x29; as quantity_un,&#xa;       s.id as stock_id,&#xa;       sph.type as movement_type,&#xa;       a.company_id&#xa;  FROM account a&#xa; INNER JOIN account_transaction at ON at.account_id &#x3d; a.id &#xa; INNER JOIN transaction t ON at.transaction_id &#x3d; t.id&#xa; INNER JOIN appointment_item ai ON ai.id &#x3d; at.appointment_item_id&#xa; INNER JOIN appointment ap ON ap.id &#x3d; ai.appointment_id&#xa; INNER JOIN service_type st ON st.id &#x3d; ai.service_type_id&#xa;  LEFT OUTER JOIN service_type_tag stt ON stt.service_type_id &#x3d; st.id&#xa;  LEFT OUTER JOIN tag tg ON stt.tag_id &#x3d; tg.id&#xa;  LEFT OUTER JOIN professional p ON p.account_id &#x3d; a.id&#xa;  LEFT OUTER JOIN stock_product_history sph ON sph.id &#x3d; ai.stock_product_history_id&#xa;  LEFT OUTER JOIN stock_product sp ON sp.id &#x3d; sph.stock_product_id&#xa;  LEFT OUTER JOIN stock s ON s.id &#x3d; sp.stock_id&#xa; WHERE a.company_id IN &#x28;&#x24;&#x7b;COMPANY_ID&#x7d;&#x29;&#xa;   AND a.type IN &#x28;&#x27;COMP&#x27;,&#x27;PROF&#x27;&#x29;&#xa;   AND tg.type IN &#x28;&#x27;SKILL&#x27;,&#x27;BRAND&#x27;&#x29;&#xa;   AND ap.status IN &#x28;&#x27;PAYMENT&#x27;,&#x27;FINISH&#x27;&#x29;&#xa;   AND at.tag_type_id &#x3d; 25&#xa;   AND t.create_date &#x3e;&#x3d; &#x27;&#x24;&#x7b;BEGIN_DATE&#x7d;&#x27;&#xa;   AND t.create_date &#x3c;&#x3d; &#x27;&#x24;&#x7b;END_DATE&#x7d;&#x27;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

