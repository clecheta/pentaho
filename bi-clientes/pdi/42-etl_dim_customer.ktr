  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>wbsl</connection>
    <sql>SELECT c.id,&#xa;       date&#x28;c.birth_date&#x29; as birth_date,&#xa;       COALESCE&#x28;c.email, &#x27;SEM EMAIL&#x27;&#x29; as email,&#xa;       c.gender,&#xa;       COALESCE&#x28;c.phone1, &#x27;SEM TEL.1&#x27;&#x29; as phone1,&#xa;       c.phone2,&#xa;       c.full_name,&#xa;       COALESCE&#x28;c.cpf, &#x27;SEM CPF&#x27;&#x29; as cpf,&#xa;       a.formatted_address as address,&#xa;       a.complement,&#xa;       a.cep,&#xa;       a.city,&#xa;       a.country,&#xa;       a.district,&#xa;       a.number,&#xa;       a.state,&#xa;       max&#x28;ap.begin_date&#x29; last_visit&#xa;  FROM customer c LEFT JOIN address a ON c.address_id&#x3d;a.id&#xa;  LEFT JOIN appointment ap ON ap.customer_id &#x3d; c.id &#xa;  INNER JOIN company_customer cc ON cc.customer_id &#x3d; c.id&#xa;  WHERE cc.company_id IN &#x28;&#x24;&#x7b;COMPANY_ID&#x7d;&#x29;&#xa; GROUP BY c.id, a.formatted_address, a.complement, a.cep, a.city, a.country, a.district, a.number, a.state&#xa; ORDER BY c.full_name</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
