    <sql>SELECT st.id service_type_id,&#xa;       st.title,&#xa;       t.name brand,&#xa;       &#x28; SELECT foo.line_list FROM &#x28;&#xa;         SELECT tg.type, string_agg&#x28;name, &#x27;, &#x27;&#x29; AS line_list FROM tag tg &#xa;          WHERE tg.id IN &#x28;SELECT stt.tag_id FROM service_type_tag stt WHERE stt.service_type_id &#x3d; st.id &#x29; &#xa;            AND tg.type &#x3d; &#x27;LINE&#x27;&#xa;          GROUP BY 1&#xa;       &#x29; AS foo&#x29; AS line,&#xa;       &#x28; SELECT distinct&#x28;t.name&#x29; FROM tag t&#xa;          INNER JOIN service_type_tag stt ON stt.tag_id &#x3d; t.id&#xa;          WHERE t.type &#x3d; &#x27;MEASURE_TYPE&#x27; AND stt.service_type_id &#x3d; st.id &#xa;       &#x29; measure_type,&#xa;       st.measure, --volume&#xa;       st.value, --valor de revenda&#xa;       st.use_value, --valor de insumo&#xa;       st.active,&#xa;       st.default_value, --valor de tabela&#xa;       st.profit, --margem revenda&#xa;       st.use_profit, --margem insumo&#xa;       st.ncm_code,&#xa;       st.bar_code,&#xa;       st.cod,&#xa;       st.weight,&#xa;       st.create_date,&#xa;       st.last_update,&#xa;       st.deleted,&#xa;       p.quantity,&#xa;       --ceil&#x28;p.quantity&#x29; as quantity_close, its given upper number than expected, used the caculator instead&#xa;       mod&#x28;CAST&#x28;&#x28;p.quantity&#x2a;st.measure&#x29; AS NUMERIC&#x29;,st.measure&#x29; as quantity_open&#xa;  FROM service_type st &#xa;  LEFT JOIN service_type_tag stt ON stt.service_type_id &#x3d; st.id&#xa;  LEFT JOIN tag t ON stt.tag_id &#x3d; t.id&#xa;  LEFT JOIN stock_product p ON p.service_type_id &#x3d; st.id&#xa; WHERE st.product &#x3d; true&#xa;   AND st.company_id IN &#x28;&#x24;&#x7b;COMPANY_ID&#x7d;&#x29;&#xa;   AND t.type&#x3d;&#x27;BRAND&#x27;&#xa; ORDER BY st.id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
