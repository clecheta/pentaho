           <schema_name/>
           </partitioning>
    <connection>wbsl</connection>
    <sql>SELECT at.create_date AS contabilization_date,&#xa;       at.description, &#xa;       --at.professional_id,&#xa;       --at.type, &#xa;       at.tag_type_id AS account_plan_id, --plano de contas&#xa;       --at.customer_id,&#xa;       --at.promo_id,&#xa;       t.value,&#xa;       t.create_date AS production_date, &#xa;       t.type_id AS payment_id, --&#x28;tag FORMA DE PAGAMENTO&#x29;&#xa;       &#x28;SELECT tag.group_id FROM tag tag WHERE t.type_id &#x3d; tag.id&#x29; AS account_group_id,&#xa;       --st.title,&#xa;       --st.id as service_type_id,&#xa;       --tg.id as skill_id,&#xa;       a.type AS account_type, --&#x27;CUST&#x27; para filtrar por contas dos clientes&#xa;       a.is_customer&#xa;  FROM account a&#xa; INNER JOIN account_transaction at ON at.account_id &#x3d; a.id &#xa; INNER JOIN transaction t ON at.transaction_id &#x3d; t.id&#xa;  --LEFT OUTER JOIN service_type st ON st.id &#x3d; ai.service_type_id&#xa;  --LEFT OUTER JOIN service_type_tag stt ON stt.service_type_id &#x3d; st.id&#xa;  --LEFT OUTER JOIN tag tg ON stt.tag_id &#x3d; tg.id&#xa; WHERE a.company_id &#x3d; 545&#xa;   AND at.settle&#x3d;true</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
